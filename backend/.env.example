MODE=sandbox
DATABASE_URL=sqlite:///./rain.db
JWT_SECRET=change-me
# LLM: agents fall back to templates when no key is set.
# LLM_PROVIDER = anthropic | openai | empty (auto: Anthropic if its key is set, else OpenAI)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# Any OpenAI model that supports structured outputs (json_schema)
OPENAI_MODEL=gpt-4.1
# Auto-tick: seconds between simulated days (0 = manual "run N days" only)
TICK_SECONDS=0
# Google Ads test account (stubbed when any are empty)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_CONVERSION_ACTION_ID=
# Meta sandbox (stubbed when any are empty)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_DATASET_ID=
